APP_NAME=AI Recruitment & Resume Intelligence System
APP_VERSION=1.0.0

# Database Settings
DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5432/ai_recruitment_db
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=ai_recruitment_db
DATABASE_USER=postgres
DATABASE_PASSWORD=your_postgres_password_here

# Security Settings
JWT_SECRET_KEY=your_secure_random_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000