# Application Settings
APP_NAME=AI Recruitment & Resume Intelligence System
APP_VERSION=1.0.0

# Database Settings
# Option A: Full Connection URL (Preferred for Render, Neon, Supabase, Railway)
# DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5432/ai_recruitment_db

# Option B: Component Settings
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=ai_recruitment_db
DATABASE_USER=postgres
DATABASE_PASSWORD=your_postgres_password_here

# Security & JWT Token Settings
JWT_SECRET_KEY=your_secure_random_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,https://your-frontend-domain.com

# Frontend API URL (Used during Vite build)
VITE_API_URL=http://127.0.0.1:8000
